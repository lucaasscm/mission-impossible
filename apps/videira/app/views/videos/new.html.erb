<% content_for :title, "Publish · Videira" %>
<h1 class="title mb-10">Publish a video</h1>

<%= form_with model: @video, class: "max-w-md" do |form| %>
  <% if @video.errors.any? %>
    <ul class="flash-error">
      <% @video.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
    </ul>
  <% end %>
  <div class="mb-6">
    <%= form.label :title, class: "label" %>
    <%= form.text_field :title, required: true, autofocus: true, class: "field" %>
  </div>
  <div class="mb-8">
    <%= form.label :file, "Video file", class: "label" %>
    <%= form.file_field :file, required: true, accept: "video/*", class: "field" %>
  </div>
  <%= form.submit "Publish", class: "btn" %>
<% end %>

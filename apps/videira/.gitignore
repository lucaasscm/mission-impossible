# Bundler config
/.bundle

# Environment files
/.env*

# Logs and tempfiles
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Uploaded files (Active Storage local disk)
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Built assets
/node_modules/
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

# Master key for decrypting credentials
/config/master.key

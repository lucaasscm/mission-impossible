<% content_for :title, "Reset password · Videira" %>
<h1 class="title mb-10">Forgot your password?</h1>

<%= form_with url: passwords_path, class: "max-w-md" do |form| %>
  <div class="mb-8">
    <%= form.label :email_address, "Email", class: "label" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "field" %>
  </div>
  <%= form.submit "Email reset instructions", class: "btn" %>
<% end %>

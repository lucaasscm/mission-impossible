<% content_for :title, "Sign in · Videira" %>
<h1 class="title mb-10">Sign in</h1>

<%= form_with url: session_url, class: "max-w-md" do |form| %>
  <div class="mb-6">
    <%= form.label :email_address, "Email", class: "label" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "field" %>
  </div>
  <div class="mb-8">
    <%= form.label :password, class: "label" %>
    <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "field" %>
  </div>
  <div class="flex items-center gap-5">
    <%= form.submit "Sign in", class: "btn" %>
    <%= link_to "Forgot password?", new_password_path, class: "link text-sm" %>
  </div>
<% end %>

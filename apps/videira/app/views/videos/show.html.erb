<% content_for :title, "#{@video.title} · Videira" %>
<p class="mb-6"><%= link_to "← All videos", root_path, class: "text-sm text-plum-400 hover:text-plum-100 transition-colors" %></p>

<%= video_tag url_for(@video.file), controls: true, preload: "metadata",
      class: "w-full aspect-video rounded-xl bg-black ring-1 ring-plum-700 shadow-[0_30px_80px_-30px_rgba(124,58,237,0.5)]" %>

<h1 class="title text-4xl mt-8 mb-2"><%= @video.title %></h1>
<p class="text-sm text-plum-400"><%= @video.user.email_address %> · <%= number_to_human_size(@video.file.byte_size) %> · <%= @video.created_at.to_date %></p>

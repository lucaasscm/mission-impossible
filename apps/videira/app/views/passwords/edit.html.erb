<% content_for :title, "New password · Videira" %>
<h1 class="title mb-10">Update your password</h1>

<%= form_with url: password_path(params[:token]), method: :put, class: "max-w-md" do |form| %>
  <div class="mb-6">
    <%= form.label :password, "New password", class: "label" %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "field" %>
  </div>
  <div class="mb-8">
    <%= form.label :password_confirmation, "Repeat new password", class: "label" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "field" %>
  </div>
  <%= form.submit "Save", class: "btn" %>
<% end %>
